# ─── Server ───────────────────────────────────────────────────────────────────
# Port the Express server listens on (AWS EC2 uses 5000; set in EC2 security group too)
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. Get from: Atlas dashboard → Connect → Drivers
# Format: mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/chromvault?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://user:password@cluster.xxxxx.mongodb.net/chromvault?retryWrites=true&w=majority

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Long random secret for JWT signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string_minimum_32_chars

# ─── Cloudinary (image uploads) ───────────────────────────────────────────────
# Get from: Cloudinary Dashboard → Settings → Access Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional full URL form (alternative to the three vars above):
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ─── Razorpay (payments) ──────────────────────────────────────────────────────
# Get from: Razorpay Dashboard → Settings → API Keys
# Use rzp_test_* keys for testing, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional: Set if you configure a Razorpay webhook for server-side confirmation
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase Cloud Messaging (Admin Push Notifications) ─────────────────────
# Get from: Firebase Console → Project Settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=chromvault-f804e
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@chromvault-f804e.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No trailing slash.
#
# TEMPORARY (Vercel domains — replace with your own domain later):
#   CORS_ORIGINS=https://chromvault-store.vercel.app,https://chromvault-admin.vercel.app
#
# PRODUCTION (after buying your GoDaddy domain):
#   CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://admin.yourdomain.com
#
# Note: Since Vercel proxies API calls server-side, CORS is mainly needed as a
# safety net. The browser never directly contacts this AWS server.
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,https://YOUR_STOREFRONT.vercel.app,https://YOUR_ADMIN.vercel.app

# ─── Node Environment ─────────────────────────────────────────────────────────
NODE_ENV=production


# Remove.bg API key for automatic product image background removal
REMOVE_BG_API_KEY=your_remove_bg_api_key
