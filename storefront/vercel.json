{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/v1/:path*",
      "destination": "http://16.16.217.90:5000/v1/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://16.16.217.90:5000/api/:path*"
    },
    {
      "source": "/products/:slug",
      "destination": "/products/template"
    },
    {
      "source": "/collections/:slug",
      "destination": "/collections/template"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
